# MQTT broker connection
MQTT_HOST=localhost
MQTT_PORT=1883

# Environment: dev | test | prod | docker
ENV=dev

# Node identity
NODE_ID=swarm-node-01
NODE_ZONE=zone_alpha
NODE_LOCATION=36.8065,10.1815

# Home altitude (meters above mean sea level)
HOME_ALT_M=50.0

# Wind model
WIND_SPEED_MPS=5.0
WIND_DIR_DEG=225.0
TURBULENCE=LIGHT

# Drone resources
PAYLOAD_TYPE=water
INITIAL_PAYLOAD_L=10.0
INITIAL_BATTERY_WH=585.9
DRONE_TANK_CAPACITY_L=10.0
DRONE_PUMP_FLOW_RATE_L_S=0.5
DRONE_LOW_PAYLOAD_L=1.5
DRONE_BATTERY_CAPACITY_WH=585.9

# Swarm configuration (leader nodes)
LEADER_ID=sl-A-01
BACKUP_PEERS=
IS_BACKUP=false
SWARM_STATUS_INTERVAL=10
LEADER_HEARTBEAT_TIMEOUT=10
ELECTION_TIMEOUT=5

# Suppression flight parameters (firefighting drones)
SUPPRESS_DROP_ALTITUDE_M=20.0
SUPPRESS_APPROACH_SPEED_MPS=6.0
SUPPRESS_TRANSIT_SPEED_MPS=14.0
SUPPRESS_EGRESS_SPEED_MPS=14.0
SUPPRESS_APPROACH_DISTANCE_M=120.0
SUPPRESS_EGRESS_DISTANCE_M=100.0
