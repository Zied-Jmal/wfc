# ──────────────────────────────────────────────────────────────
# infrastructure/docker/.env.docker — Docker Compose environment
# ──────────────────────────────────────────────────────────────
# Inside the wfc-net Docker bridge network, the broker is
# reachable at its service name, not localhost.
ENV=prod
MQTT_HOST=wfc-mosquitto
MQTT_PORT=1883

DEBUG=1
DEBUG_LEVEL=TRACE
DEBUG_CHANNELS=BUS,COMMANDS,APPROVAL,TRACKER,MQTT,HEARTBEAT,SYSTEM,REGISTRY,RULES,STATE,DEBUG
DEBUG_ALL=0
