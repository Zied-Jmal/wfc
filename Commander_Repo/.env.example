# MQTT broker connection
MQTT_HOST=localhost
MQTT_PORT=1883

# Python path (for local development)
PYTHONPATH=.

# Environment: dev | test | prod | docker
ENV=dev

# Debug options
DEBUG=1
DEBUG_LEVEL=TRACE
DEBUG_CHANNELS=BUS,COMMANDS,APPROVAL,TRACKER,MQTT,HEARTBEAT,SYSTEM,REGISTRY,RULES,STATE
DEBUG_ALL=0
