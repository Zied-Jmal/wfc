# ──────────────────────────────────────────────────────────────
# .env.docker — shared defaults for all WFC main-project containers
# Per-node overrides (NODE_ID, NODE_ZONE, etc.) are set directly in
# docker-compose.yml's environment: block for each service.
# ──────────────────────────────────────────────────────────────
ENV=prod
MQTT_HOST=mosquitto
MQTT_PORT=1883
PYTHONPATH=.

DEBUG=1
DEBUG_LEVEL=INFO
DEBUG_CHANNELS=COMMANDS,APPROVAL,TRACKER,MQTT,HEARTBEAT,SYSTEM,REGISTRY,RULES,STATE
DEBUG_ALL=0

# Leave empty — get_db_path() derives data/<NODE_ID>.db automatically per node.
WFC_DB_PATH=
